generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  VIEWER
}

enum MovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER
}

enum OrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model Workspace {
  id         String       @id @default(cuid())
  name       String
  createdAt  DateTime     @default(now())
  users      User[]
  products   Product[]
  balances   StockBalance[]
  suppliers  Supplier[]
  categories Category[]
  brands     Brand[]
  movements  StockMovement[]
  orders     PurchaseOrder[]
  transfers  StockTransfer[]
  settings   WorkspaceSettings?
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([workspaceId])
}

model Product {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  sku         String
  category    String
  brand       String
  stock       Int      @default(0)
  minStock    Int      @default(0)
  price       Float    @default(0)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  location    String   @default("Store Room")
  barcode     String?
  expiry      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  movements   StockMovement[]
  orderLines  PurchaseOrderLine[]
  transfers   StockTransfer[]
  balances    StockBalance[]

  @@unique([workspaceId, sku])
  @@unique([workspaceId, barcode])
  @@index([workspaceId, category])
  @@index([workspaceId, stock])
}

model Supplier {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  email       String
  phone       String?
  leadTime    Int       @default(7)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      PurchaseOrder[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Category {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  @@unique([workspaceId, name])
}

model Brand {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  createdAt   DateTime  @default(now())
  @@unique([workspaceId, name])
}

model StockMovement {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  type        MovementType
  quantity    Int
  location    String?
  reason      String
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@index([productId, createdAt])
}

model StockBalance {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location    String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt

  @@unique([productId, location])
  @@index([workspaceId, location])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  workspaceId String
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status      OrderStatus         @default(DRAFT)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  receivedAt  DateTime?
  lines       PurchaseOrderLine[]

  @@index([workspaceId, status])
}

model PurchaseOrderLine {
  id        String        @id @default(cuid())
  orderId   String
  order     PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int

  @@unique([orderId, productId])
}

model StockTransfer {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  from        String
  to          String
  quantity    Int
  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt])
}

model WorkspaceSettings {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  threshold   Int       @default(10)
  expiryDays  Int       @default(30)
  currency    String    @default("USD")
  updatedAt   DateTime  @updatedAt
}

